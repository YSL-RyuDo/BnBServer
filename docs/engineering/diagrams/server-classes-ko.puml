@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Malgun Gothic"
skinparam defaultFontSize 15
skinparam ArrowColor #444444
skinparam Padding 10
skinparam sequenceMessageAlign center
hide footbox
title 방 소유 관계와 공유 상태
hide empty members
class Server
class ClientHandler {
  GetClientsMapLocked()
}
class RoomManager {
  - roomsMutex : mutex
  - rooms : vector<Room>
  - resolvedRooms
  + GetRoomByUserId() : shared_ptr<const Room>
  + RecordDeath()
  + RetryDeath(snapshot, userId)
  + HandleReadyToExit()
}
class Room {
  users : vector<string>
  matchId : uint64_t
  isInGame : bool
}
class UserManager {
  - usersMutex : recursive_mutex
  + LockState()
}
class Transaction {
  - beforeImages
  - pendingFiles
  + Commit()
}
class CsvStore {
  Commit(afterImages)
  Recover()
}
class ClientInfo
class SocketOutput {
  Enqueue()
  Stop()
}
Server *-- ClientHandler
Server *-- RoomManager
Server *-- UserManager
RoomManager *-- Room
ClientHandler --> RoomManager
ClientHandler --> UserManager
UserManager +-- Transaction
Transaction --> CsvStore
ClientInfo o-- SocketOutput
RoomManager ..> ClientInfo : retain recipients under lock
RoomManager ..> SocketOutput : enqueue after releasing locks
ClientHandler --> ClientInfo : clientsMutex
note bottom of SocketOutput
1 shared IOCP output worker
256 KiB / 4096 frames per connection
1 in-flight send per connection
end note
@enduml
