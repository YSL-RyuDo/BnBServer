@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Malgun Gothic"
skinparam defaultFontSize 15
skinparam ArrowColor #444444
skinparam Padding 10
skinparam sequenceMessageAlign center
hide footbox
title Movement delivery after the October 2026 fix
participant "Sending client" as A
participant ClientHandler as H
participant RoomManager as R
participant "Other clients in the same room" as B
A -> H : MOVE|nickname|x,z\n
activate H
H -> H : Buffer until newline; retain an incomplete tail
H -> H : Check session nickname and finite coordinates
H -> H : Player.UpdatePlayerPosition()
H -> R : BroadcastToRoomExcept(socket, result)
activate R
R -> R : Resolve room; exclude sender
note right of R : roomsMutex, then clientsMutex
R -> B : MOVE_RESULT|nickname,x,z\n
note over R,B : Blocking send while locks are held
deactivate R
deactivate H
@enduml
